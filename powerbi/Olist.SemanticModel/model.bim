        ],
        "lineageTag": "3f7874bc-4d75-494f-a54c-3e8500fe10d2",
        "measures": [
          {
            "name": "Top fifth sales share",
            "expression": "CALCULATE(MAX(q2_quintiles[revenue_share_pct]),q2_quintiles[quintile]=1)/100",
            "formatString": "0.00%",
            "lineageTag": "114e8080-1ce4-4758-8d1a-2438f80688de"
          },
          {
            "name": "Sales share",
            "expression": "MAX(q2_quintiles[revenue_share_pct])/100",
            "formatString": "0.00%",
            "lineageTag": "d69aa76e-5321-471a-98d5-9642e3d3259f"
          },
          {
            "name": "Cumulative share",
            "expression": "VAR q=MAX(q2_quintiles[quintile]) RETURN DIVIDE(CALCULATE(SUM(q2_quintiles[revenue_brl]),FILTER(ALL(q2_quintiles),q2_quintiles[quintile]<=q)),CALCULATE(SUM(q2_quintiles[revenue_brl]),REMOVEFILTERS(q2_quintiles)))",
            "formatString": "0.00%",
            "lineageTag": "3929eaab-765a-49d0-97c8-7cc0278da989"
          }
        ],

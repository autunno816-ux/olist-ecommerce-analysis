          }
        ],
        "lineageTag": "ee6de7c2-493a-4f00-9975-6350ffe16877",
        "measures": [
          {
            "name": "Purchasing customers",
            "expression": "CALCULATE(SUM(q2_customer_segments[customer_count]),REMOVEFILTERS(q2_customer_segments))",
            "formatString": "#,0",
            "lineageTag": "caa78592-7e9f-4b71-a052-ce1dc6fa842b"
          },
          {
            "name": "Repeat customers",
            "expression": "CALCULATE(SUM(q2_customer_segments[customer_count]),q2_customer_segments[customer_type]=\"Repeat\")",
            "formatString": "#,0",
            "lineageTag": "475928a4-510a-4b33-920a-3606015a0a4b"
          },
          {
            "name": "Repeat customer spend",
            "expression": "CALCULATE(MAX(q2_customer_segments[average_revenue_per_customer_brl]),q2_customer_segments[customer_type]=\"Repeat\")",
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "596b9711-2483-4eac-8029-b60d2f02737e"
          },
          {

        "lineageTag": "645c9d1a-a2a5-4493-84b5-4f6777ffce71",
        "measures": [
          {
            "name": "Total sales",
            "expression": "CALCULATE(SUM(q1_states[revenue_brl]), REMOVEFILTERS(q1_states)) / 1000000",
            "formatString": "\"R$ \"0.00\"m\"",
            "lineageTag": "ad745402-b17a-4f4c-bf0d-a6ee3bd3804f"
          },
          {
            "name": "Delivered orders",
            "expression": "CALCULATE(SUM(q1_states[order_count]), REMOVEFILTERS(q1_states))",
            "formatString": "#,0",
            "lineageTag": "56b8b0c2-dec9-47c9-8607-48c21d55d89f"
          },
          {
            "name": "Top 3 state share",
            "expression": "DIVIDE(SUMX(TOPN(3,ALL(q1_states),q1_states[revenue_brl],DESC),q1_states[revenue_brl]),CALCULATE(SUM(q1_states[revenue_brl]),REMOVEFILTERS(q1_states)))",
            "formatString": "0.00%",
            "lineageTag": "81b12755-5503-439d-aee7-c0786092f8e1"
          }
        ],

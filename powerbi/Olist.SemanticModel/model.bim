            "sourceColumn": "mom_growth_pct",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Month label",
            "dataType": "string",
            "expression": "FORMAT(q1_monthly[month], \"MMM yy\", \"en-US\")",
            "summarizeBy": "none",
            "sortByColumn": "month"
          }
        ],
        "lineageTag": "2ab25615-92b3-473d-92cb-67ce4e52cd5a",
        "measures": [
          {
            "name": "Sales (BRL)",
            "expression": "SUM('q1_monthly'[revenue_brl]) / 1000000",
            "formatString": "\"R$ \"0.0\"m\"",
            "lineageTag": "ef0f2bfa-f7e6-47ba-8ca4-69057d963d50"
          },
          {
            "name": "Orders",
            "expression": "SUM('q1_monthly'[order_count])",
            "formatString": "#,0",
            "lineageTag": "af6a9d70-f036-4698-8c6c-e1ef95343aab"
          },
          {
            "name": "Growth",
            "expression": "VAR v = SELECTEDVALUE(q1_monthly[mom_growth_pct]) RETURN IF(v>=0 && NOT ISBLANK(v),v/100)",
            "formatString": "0.0%",
            "lineageTag": "6cf16db2-1080-43ce-a4aa-4b25aea7b0b3"
          },
          {
            "name": "Decline",
            "expression": "VAR v = SELECTEDVALUE(q1_monthly[mom_growth_pct]) RETURN IF(v<0,v/100)",
            "formatString": "0.0%",
            "lineageTag": "abbdaeb5-3386-4215-b454-823a19e277cb"
          }
        ],
        "partitions": [
          {
            "name": "q1_monthly",
            "mode": "import",
            "source": {
              "expression": [
                "let",
